{
  "menus": {
    "main": {
      "type": "list",
      "header": "Escolha uma das opções abaixo:",
      "body": null,
      "options": [
        { "id": "0", "title": "Entregas", "description": "Ver e escolher entrega." },
        { "id": "1", "title": "Status", "description": "Atualizar status" },
        { "id": "2", "title": "Cancelar", "description": "Cancelar atendimento" }
      ]
    },
    "entregas": {
      "type": "list",
      "header": "Entregas pendentes",
      "body": "Selecione uma das opções abaixo",
      "options": "taskList"
    },
    "cancel": {
      "type": "text",
      "content": "Atendimento cancelado. Obrigado!"
    },
    "confirma_tarefa": [
      {
        "type": "list",
        "header": "Confirma a escolha da seguinte tarefa?",
        "body": "Endereço: {{address}}\nID: {{taskId}}",
        "options": [
          { "id": "0", "title": "Sim", "description": null },
          { "id": "1", "title": "Não", "description": null }
        ]
      }
    ],
    "status_entrega": {
      "type": "list",
      "header": "Escolha o Tipo de Entrega",
      "body": "Selecione uma das opções abaixo:",
      "options": [
        { "id": "0", "title": "Sucesso", "description": "Entrega realizada" },
        { "id": "1", "title": "Pendência", "description": "Entrega com pendência" },
        { "id": "2", "title": "Insucesso", "description": "Entrega não realizada" },
        { "id": "3", "title": "Voltar", "description": "Retornar ao menu principal" },
        { "id": "4", "title": "Cancelar", "description": "Cancelar atendimento" }
      ]
    },
    "sucesso_confirma": {
      "type": "list",
      "header": "Confirma os dados da NF?",
      "body": "NF: {{nf}}\nRemetente: (consultado no ERP)\nDestinatário: (consultado no ERP)",
      "options": [
        { "id": "0", "title": "Sim", "description": null },
        { "id": "1", "title": "Não", "description": null }
      ]
    },
    "sucesso_inicial": [
      {
        "type": "conditional",
        "condition": "hasNfe",
        "true": [
          {
            "type": "text",
            "content": "Nota fiscal vinculada à tarefa: {{nfe}}"
          },
          {
            "type": "reference",
            "menu": "sucesso_confirma",
            "params": ["nfe"]
          }
        ],
        "false": [
          {
            "type": "text",
            "content": "Por favor, informe o número da NF para continuar."
          }
        ]
      }
    ],
    "pendencia_tipo": {
      "type": "list",
      "header": "Informe o tipo de pendência:",
      "body": "Selecione uma das opções abaixo:",
      "options": [
        { "id": "0", "title": "Avaria" },
        { "id": "1", "title": "Falta" },
        { "id": "2", "title": "Inversão/Troca de volumes" }
      ]
    },
    "pendencia_total": {
      "type": "list",
      "header": "A pendência é total ou parcial?",
      "body": "Selecione uma das opções abaixo:",
      "options": [
        { "id": "0", "title": "Total" },
        { "id": "1", "title": "Parcial" }
      ]
    },
    "insucesso_tipo": {
      "type": "list",
      "header": "Informe o motivo do insucesso:",
      "body": "Selecione uma das opções abaixo:",
      "options": [
        { "id": "0", "title": "Comprovante Retido" },
        { "id": "1", "title": "Divergência Comercial" },
        { "id": "2", "title": "Endereço não localizado" },
        { "id": "3", "title": "Destinatário ausente" },
        { "id": "4", "title": "Recusa/Impossibilidade" }
      ]
    }
  },
  
  "stateMap": {
    "MENU_MAIN": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive'",
            "switch": "interactive_id",
            "cases": {
              "0": {
                "next": "MENU_ENTREGAS",
                "reply": {"menu": "entregas"}
              },
              "1": {
                "conditions": [
                  {
                    "if": "currentTaskId",
                    "then": {
                      "next": "STATUS_ENTREGA",
                      "reply": {"menu": "status_entrega"}
                    }
                  },
                  {
                    "if": "!currentTaskId",
                    "then": {
                      "next": "MENU_ENTREGAS",
                      "reply": [
                        {"type": "text", "content": "Nenhuma tarefa em andamento. Escolha uma nova:"},
                        {"menu": "entregas"}
                      ]
                    }
                  }
                ]
              },
              "2": {
                "next": "FINISHED",
                "reply": {"menu": "cancel"},
                "active": false
              }
            },
            "default": {
              "next": "MENU_MAIN",
              "reply": {"type": "text", "content": "Opção inválida. Por favor, selecione do menu."},
              "incRetry": true
            }
          },
          {
            "if": "inputType !== 'interactive'",
            "then": {
              "next": "MENU_MAIN",
              "reply": {"type": "text", "content": "Por favor, selecione uma opção do menu."},
              "incRetry": true
            }
          }
        ]
      }
    },

    "MENU_ENTREGAS": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive'",
            "switch": "interactive_id",
            "cases": {
              "{{taskList.length}}": {
                "next": "MENU_ENTREGAS",
                "reply": {"menu": "entregas"}
              },
              "{{taskList.length + 1}}": {
                "next": "MENU_MAIN",
                "reply": {"menu": "main"}
              }
            },
            "default": {
              "next": "CONFIRMACAO",
              "reply": {"menu": "confirma_tarefa"},
              "task_id": "tasks[interactive_id].id"
            }
          },
          {
            "if": "inputType !== 'interactive'",
            "then": {
              "next": "MENU_ENTREGAS",
              "reply": {"type": "text", "content": "Por favor, selecione uma opção do menu."},
              "incRetry": true
            }
          }
        ]
      }
    },

    "CONFIRMACAO": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive'",
            "switch": "interactive_id",
            "cases": {
              "0": {
                "next": "FINISHED",
                "reply": [
                  {"type": "text", "content": "Status da tarefa {{currentTaskId}} alterado para: \"Em andamento\""},
                  {"type": "gmaps_button", "latitude": "currentTask.latitude", "longitude": "currentTask.longitude"}
                ],
                "status": 1,
                "window_start": "nowISO()"
              },
              "1": {
                "next": "MENU_ENTREGAS",
                "reply": {"menu": "entregas"},
                "task_id": null
              }
            }
          },
          {
            "if": "inputType !== 'interactive'",
            "then": {
              "next": "CONFIRMACAO",
              "reply": {"type": "text", "content": "Por favor, selecione uma opção do menu."},
              "incRetry": true
            }
          }
        ]
      }
    },

    "STATUS_ENTREGA": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive'",
            "switch": "interactive_id",
            "cases": {
              "0": {
                "next": "ENTREGA_SUCESSO",
                "reply": {"function": "sucesso_inicial"}
              },
              "1": {
                "next": "ENTREGA_PENDENCIA_TIPO",
                "reply": {"menu": "pendencia_tipo"}
              },
              "2": {
                "next": "ENTREGA_INSUCESSO_TIPO",
                "reply": {"menu": "insucesso_tipo"}
              },
              "3": {
                "next": "MENU_ENTREGAS",
                "reply": {"menu": "entregas"}
              },
              "4": {
                "next": "FINISHED",
                "reply": {"menu": "cancel"},
                "task_id": null
              }
            },
            "default": {
              "next": "STATUS_ENTREGA",
              "reply": {"type": "text", "content": "Selecione uma opção válida."}
            }
          }
        ],
        "default": {
          "next": "STATUS_ENTREGA",
          "reply": {"menu": "status_entrega"},
          "incRetry": true
        }
      }
    },

    "ENTREGA_PENDENCIA_TIPO": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive'",
            "then": {
              "next": "ENTREGA_PENDENCIA_TOTALIDADE",
              "reply": {"menu": "pendencia_total"},
              "context_patch": {"tipo_pendencia": "interactive_id"}
            }
          }
        ],
        "default": {
          "next": "ENTREGA_PENDENCIA_TIPO",
          "reply": {"menu": "pendencia_tipo"}
        }
      }
    },

    "ENTREGA_PENDENCIA_TOTALIDADE": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive'",
            "then": {
              "next": "ENTREGA_PENDENCIA_FOTO",
              "reply": {"type": "text", "content": "Envie a foto da NFD, ressalva ou volumes invertidos."},
              "context_patch": {"totalidade": "interactive_id"}
            }
          }
        ],
        "default": {
          "next": "ENTREGA_PENDENCIA_TOTALIDADE",
          "reply": {"menu": "pendencia_total"}
        }
      }
    },

    "ENTREGA_PENDENCIA_FOTO": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'image' || inputType === 'document'",
            "then": {
              "next": "ENTREGA_PENDENCIA_NOME",
              "reply": {"type": "text", "content": "Informe o nome do recebedor."}
            }
          }
        ],
        "default": {
          "next": "ENTREGA_PENDENCIA_FOTO",
          "reply": {"type": "text", "content": "Aguardando foto."}
        }
      }
    },

    "ENTREGA_PENDENCIA_NOME": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'text'",
            "then": {
              "next": "FINISHED",
              "reply": {"type": "text", "content": "Ocorrência registrada. Retornar carga para unidade."},
              "status": 3,
              "window_end": "nowISO()",
              "active": false
            }
          }
        ],
        "default": {
          "next": "ENTREGA_PENDENCIA_NOME",
          "reply": {"type": "text", "content": "Informe o nome do recebedor."}
        }
      }
    },

    "ENTREGA_INSUCESSO_TIPO": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive'",
            "then": {
              "next": "ENTREGA_INSUCESSO_INTERACAO",
              "reply": {
                "type": "text",
                "content": "Motivo selecionado: {{motivos[interactive_id]}}\nA torre será notificada."
              },
              "context_patch": {
                "motivo_insucesso": "motivos[interactive_id]"
              },
              "variables": {
                "motivos": [
                  "Comprovante Retido",
                  "Divergência Comercial",
                  "Endereço não localizado",
                  "Destinatário ausente",
                  "Recusa/Impossibilidade"
                ]
              }
            }
          }
        ],
        "default": {
          "next": "ENTREGA_INSUCESSO_TIPO",
          "reply": {"menu": "insucesso_tipo"}
        }
      }
    },

    "ENTREGA_INSUCESSO_INTERACAO": {
      "action": {
        "next": "ENTREGA_INSUCESSO_FINAL",
        "reply": {"type": "text", "content": "Aguarde, a torre entrará em contato com o cliente (prazo: até 20 minutos)."}
      }
    },

    "ENTREGA_INSUCESSO_FINAL": {
      "action": {
        "next": "FINISHED",
        "reply": {"type": "text", "content": "Ocorrência registrada. Retornar carga para unidade."},
        "status": 4,
        "window_end": "nowISO()",
        "active": false
      }
    },

    "ENTREGA_SUCESSO": {
      "action": {
        "conditions": [
          {
            "if": "currentTask && currentTask.nfe",
            "then": {
              "next": "ENTREGA_SUCESSO_CONFIRMA",
              "reply": {"function": "sucesso_confirma", "params": ["currentTask.nfe"]},
              "context_patch": {"nf": "currentTask.nfe"}
            }
          },
          {
            "if": "inputType === 'text'",
            "then": {
              "conditions": [
                {
                  "if": "text.replace(/\\D/g, '')",
                  "then": {
                    "next": "ENTREGA_SUCESSO_CONFIRMA",
                    "reply": {"function": "sucesso_confirma", "params": ["text.replace(/\\\\D/g, '')"]},
                    "context_patch": {"nf": "text.replace(/\\\\D/g, '')"}
                  }
                },
                {
                  "if": "!text.replace(/\\D/g, '')",
                  "then": {
                    "next": "ENTREGA_SUCESSO",
                    "reply": {"type": "text", "content": "Informe o número da NF (apenas números)."},
                    "incRetry": true
                  }
                }
              ]
            }
          }
        ],
        "default": {
          "next": "ENTREGA_SUCESSO",
          "reply": {"type": "text", "content": "Por favor, informe o número da NF."}
        }
      }
    },

    "ENTREGA_SUCESSO_CONFIRMA": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'interactive' && interactive_id === '0'",
            "then": {
              "next": "ENTREGA_SUCESSO_FOTO",
              "reply": {"type": "text", "content": "Envie a foto do comprovante (deve conter nome, data e carimbo)."}
            }
          },
          {
            "if": "inputType === 'interactive' && interactive_id === '1'",
            "then": {
              "next": "MENU_MAIN",
              "reply": {"type": "text", "content": "Documento não localizado. Contate a unidade."},
              "active": false
            }
          }
        ],
        "default": {
          "next": "ENTREGA_SUCESSO_CONFIRMA",
          "reply": {"type": "text", "content": "Selecione uma opção."}
        }
      }
    },

    "ENTREGA_SUCESSO_FOTO": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'image' || inputType === 'document'",
            "then": {
              "next": "ENTREGA_SUCESSO_NOME",
              "reply": {"type": "text", "content": "Informe o nome do recebedor."}
            }
          }
        ],
        "default": {
          "next": "ENTREGA_SUCESSO_FOTO",
          "reply": {"type": "text", "content": "Aguardando foto do comprovante."}
        }
      }
    },

    "ENTREGA_SUCESSO_NOME": {
      "action": {
        "conditions": [
          {
            "if": "inputType === 'text'",
            "then": {
              "next": "FINISHED",
              "reply": {"type": "text", "content": "Entrega registrada com sucesso. Obrigado!"},
              "status": 2,
              "window_end": "nowISO()",
              "active": false
            }
          }
        ],
        "default": {
          "next": "ENTREGA_SUCESSO_NOME",
          "reply": {"type": "text", "content": "Informe o nome do recebedor."}
        }
      }
    }
  }
}