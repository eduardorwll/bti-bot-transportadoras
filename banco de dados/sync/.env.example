# =============================================================================
# Exemplo de variáveis de ambiente - copie para .env e ajuste os valores
# Configurações para os scripts de sincronização
# =============================================================================

# -----------------------------------------------------------------------------
# Configurações SSH
# -----------------------------------------------------------------------------
SSH_HOST=                     # Endereço do servidor SSH onde está o BD do ERP
SSH_PORT=22                   # Porta SSH (padrão: 22)
SSH_USERNAME=                 # Usuário SSH
SSH_KEY_PATH=                 # Caminho para a chave privada SSH (ex: ~/.ssh/id_rsa)

# -----------------------------------------------------------------------------
# Configurações do Banco de Dados ERP
# -----------------------------------------------------------------------------
DB_HOST=localhost            # Host do banco de dados (geralmente localhost via túnel SSH)
DB_PORT=5432                # Porta do banco de dados PostgreSQL (padrão: 5432)
DB_NAME=                    # Nome do banco de dados
DB_USER=                    # Usuário do banco de dados
DB_PASSWORD=                # Senha do banco de dados
LOCAL_PORT=5433            # Porta local para o túnel SSH (padrão: 5433)

# -----------------------------------------------------------------------------
# Configurações do Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=              # URL do seu projeto Supabase (ex: https://xyz.supabase.co)
SUPABASE_KEY=              # Chave de API do Supabase (anon key ou service_role key)

# -----------------------------------------------------------------------------
# Configurações de Sincronização
# -----------------------------------------------------------------------------
# Intervalo para sincronização de dados operacionais (em minutos)
SYNC_INTERVAL=5            # A cada 5 minutos

# Intervalo para sincronização de dados organizacionais (em minutos)
ORG_SYNC_INTERVAL=60       # A cada 1 hora

# -----------------------------------------------------------------------------
# Configurações de Log (opcionais - usadas pelo logging básico do Python)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO            # Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_PATH=./logs          # Diretório para os arquivos de log

# -----------------------------------------------------------------------------
# Variáveis adicionais identificadas nos scripts
# -----------------------------------------------------------------------------
# As variáveis abaixo têm valores padrão nos scripts, mas podem ser sobrescritas
# via ambiente se necessário para casos específicos

# SSH_PRIVATE_KEY - alternativa para SSH_KEY_PATH (não usada mas documentada)
# SSH_PASSWORD - para autenticação por senha (não implementada nos scripts atuais)

# Valores padrão já definidos nos scripts:
# SYNC_INTERVAL padrão: 5 minutos (sync_ops.py)
# ORG_SYNC_INTERVAL padrão: 60 minutos (sync_org.py) 
# SSH_PORT padrão: 22
# DB_PORT padrão: 5432  
# DB_HOST padrão: localhost
# LOCAL_PORT padrão: 5433