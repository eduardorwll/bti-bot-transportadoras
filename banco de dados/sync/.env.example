# =============================================================================# Exemplo de variáveis de ambiente - copie para .env e ajuste os valores

# Configurações para os scripts de sincronizaçãoSSH_HOST=servidor-erp

# =============================================================================SSH_USER=usuario

SSH_KEY_PATH=/path/to/your/private/key

# -----------------------------------------------------------------------------SSH_PASSWORD=  # Deixe vazio se usar key-based auth

# Configurações SSH

# -----------------------------------------------------------------------------DB_NAME=nome_banco_erp

SSH_HOST=                     # Endereço do servidor SSH (ex: erp.empresa.com.br)DB_USER=usuario_banco

SSH_PORT=22                   # Porta SSH (padrão: 22)DB_PASS=senha_banco

SSH_USERNAME=                 # Usuário SSH

SSH_KEY_PATH=                 # Caminho para a chave privada SSH (ex: ~/.ssh/id_rsa)SUPABASE_URL=https://sua-instancia.supabase.co

SUPABASE_KEY=sua-chave-api

# -----------------------------------------------------------------------------

# Configurações do Banco de Dados ERP# Configurações opcionais

# -----------------------------------------------------------------------------SYNC_INTERVAL_MINUTES=60  # Para execução via cron

DB_HOST=localhost            # Host do banco de dados (geralmente localhost via túnel SSH)BACKUP_DIR=sync_backups  # Diretório para backups JSON
DB_PORT=5432                # Porta do banco de dados PostgreSQL (padrão: 5432)
DB_NAME=                    # Nome do banco de dados
DB_USER=                    # Usuário do banco de dados
DB_PASSWORD=                # Senha do banco de dados
LOCAL_PORT=5433            # Porta local para o túnel SSH (padrão: 5433)

# -----------------------------------------------------------------------------
# Configurações do Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=              # URL do seu projeto Supabase
SUPABASE_KEY=              # Chave de API do Supabase (anon key ou service_role key)

# -----------------------------------------------------------------------------
# Configurações de Sincronização
# -----------------------------------------------------------------------------
# Intervalo para sincronização de dados operacionais (em minutos)
SYNC_INTERVAL=5            # A cada 5 minutos

# Intervalo para sincronização de dados organizacionais (em minutos)
ORG_SYNC_INTERVAL=60       # A cada 1 hora

# -----------------------------------------------------------------------------
# Configurações de Log
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO            # Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_PATH=./logs          # Diretório para os arquivos de log